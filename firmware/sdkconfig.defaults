# Common to every board. Board specifics: sdkconfig.defaults.esp32cam / .esp32s3cam / .freenove_esp32s3_cam.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# TLS (MQTT to AWS IoT Core, HTTPS to FlyBot): buffers in PSRAM, smaller output buffer
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y

# OTA: two app slots, the new image must mark itself valid (proto.c does it on the first MQTT connect)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Power: Wi-Fi modem sleep + automatic light sleep (CAMOS_LIGHT_SLEEP)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# web console: up to 8 browser connections (one of them a live MJPEG stream) + MQTT, HTTPS, SNTP, DNS
CONFIG_LWIP_MAX_SOCKETS=16

# 4G: PPP in lwIP (esp_modem)
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y

# Setup portal: catch-all handler redirects to the form; JSON bodies up to 12 KB (certificate + key)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Serial console (esp_console REPL on UART0)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# The default event loop task runs the Wi-Fi / IP handlers (LED, time sync start): 2304 bytes overflowed
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
