# Freenove ESP32-S3-WROOM CAM board (kit FNK0085): ESP32-S3-WROOM-1 N8R8 or N16R8 (8 MB octal PSRAM, 8 or 16 MB flash),
# OV5640 (OV2640 detected too), microSD (SD_MMC 1-bit: CLK 39, CMD 38, D0 40), WS2812 RGB LED on GPIO48, two USB-C
# (CH340 UART + native USB). Pin map verified against Freenove/Freenove_ESP32_S3_WROOM_Board Sketch_07.1 camera_pins.h
# (CAMERA_MODEL_ESP32S3_EYE). The image declares 8 MB flash so that one release runs on both variants (the partition
# table ends at 6.25 MB with the coredump partition; a 16 MB chip only logs that it is larger).
CONFIG_CAMOS_BOARD_FREENOVE_S3CAM=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_FILENAME="partitions-8mb.csv"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8mb.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_OV2640_SUPPORT=y
CONFIG_OV3660_SUPPORT=y
CONFIG_OV5640_SUPPORT=y
# The board's OV5640 gives an upside-down picture as the board is mounted: the sensor flips it back (Freenove's own
# camera example does the same); video.image.vflip / hmirror are relative to this upright picture
CONFIG_CAMOS_CAM_VFLIP=y
# The native USB port also carries the log (the CH340 port is UART0: console and flashing)
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
# Cloud live view (docs/dev/LIVE_VIEW.md): KVS WebRTC MASTER with software H.264 (esp_peer, esp_h264)
CONFIG_CAMOS_LIVE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_ESP_WS_CLIENT_ENABLE_DYNAMIC_BUFFER=y
# the presigned WSS URL of the signaling channel carries the session token: the upgrade request needs room
CONFIG_WS_BUFFER_SIZE=6144
# A WebRTC session (ICE, DTLS-SRTP, RTP pools, the encoder) next to Wi-Fi, MQTT and the web console: allocations of
# 256 bytes and up (as in Espressif's kvs_master), and Wi-Fi / lwIP buffers when they can, go to PSRAM; the camera DMA
# buffers stay internal (a JPEG data channel session ran the internal heap down to 23 bytes with 1 KB)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# with Wi-Fi buffers in PSRAM the block-ack window defaults to 16, more than twice the 6 static RX buffers (build error)
CONFIG_ESP_WIFI_RX_BA_WIN=6
# Camera DMA: during a live session the H.264 pipeline's YUV422 frames go by DMA straight into PSRAM and the session
# holds a 16 KB internal block for every JPEG start (cam.c): esp32-camera's JPEG mode takes a fixed 16 KB internal
# buffer whatever this says (its PSRAM DMA mode loses the JPEG end markers). This limit only sizes the YUV422 transfer.
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=15360
# The web console's MJPEG stream and the photo uploads are TCP: with the default 5,760-byte send buffer a Wi-Fi with a
# 30-100 ms round trip carried about 60 KB/s (a 640x480 frame took 180 ms to send, the camera 50 ms to take it).
# 16 segments; the buffers are in PSRAM (SPIRAM_TRY_ALLOCATE_WIFI_LWIP)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040
# USB host (usbMode "stick"): give slow USB drives time; their first enumeration failed with the 250/30/30 ms
# defaults ("Dev 0 EP 0 Error"), and power-cycling the root port to retry races the hub driver (abort in hub.c)
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=1000
CONFIG_USB_HOST_RESET_HOLD_MS=50
CONFIG_USB_HOST_RESET_RECOVERY_MS=200
CONFIG_USB_HOST_SET_ADDR_RECOVERY_MS=50
