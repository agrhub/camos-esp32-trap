# AI-Thinker ESP32-CAM: ESP32 (240 MHz capable, run at 160), 4 MB flash, 4 MB quad PSRAM (only 4 MB addressable), OV2640
CONFIG_CAMOS_BOARD_ESP32CAM=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_FILENAME="partitions-4mb.csv"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-4mb.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_OV2640_SUPPORT=y
CONFIG_OV3660_SUPPORT=y
CONFIG_OV5640_SUPPORT=n
