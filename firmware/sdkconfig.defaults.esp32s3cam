# ESP32-S3 N16R8 CAM: 16 MB quad flash, 8 MB octal PSRAM, OV3660 (also OV5640 / OV2640 are detected)
CONFIG_CAMOS_BOARD_ESP32S3CAM=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_FILENAME="partitions-16mb.csv"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16mb.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_OV2640_SUPPORT=y
CONFIG_OV3660_SUPPORT=y
CONFIG_OV5640_SUPPORT=y
# USB-C boards: the log also goes to the native USB port
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
# esp_peer (live view) is in the S3 component list: it needs DTLS-SRTP to compile. CAMOS_LIVE stays off on this
# untested board (turn it on in menuconfig: docs/dev/LIVE_VIEW.md)
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
